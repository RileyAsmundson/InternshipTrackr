<main class="container py-4" style="max-width: 720px;">
  <h1 class="mb-4">My Profile</h1>

  {{#if error}}
    <div class="alert alert-danger" role="alert">
      {{error}}
    </div>
  {{/if}}

  {{#if saved}}
    <div class="alert alert-success" role="status">
      Your profile was updated.
    </div>
  {{/if}}

  <section class="card mb-4" aria-labelledby="account-heading">
    <div class="card-body">
      <h2 id="account-heading" class="h4">
        Account information
      </h2>

      <dl class="row mb-0">
        <dt class="col-sm-4">First name</dt>
        <dd class="col-sm-8">{{profile.first_name}}</dd>

        <dt class="col-sm-4">Last name</dt>
        <dd class="col-sm-8">{{profile.last_name}}</dd>

        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8">{{profile.email}}</dd>

        <dt class="col-sm-4">Phone number</dt>
        <dd class="col-sm-8">
          {{#if profile.phone_number}}
            {{profile.phone_number}}
          {{else}}
            Not provided yet
          {{/if}}
        </dd>
      </dl>
    </div>
  </section>

  <section class="card mb-4" aria-labelledby="phone-heading">
    <div class="card-body">
      <h2 id="phone-heading" class="h4">
        Update phone number
      </h2>

      <form action="/profile/phone" method="POST">
        <input
          type="hidden"
          name="csrfToken"
          value="{{csrfToken}}"
        >

        <div class="mb-3">
          <label class="form-label" for="phoneNumber">
            Phone number
          </label>

          <input
            class="form-control"
            type="tel"
            id="phoneNumber"
            name="phoneNumber"
            value="{{profile.phone_number}}"
            autocomplete="tel"
            maxlength="16"
            pattern="[+]?[0-9]{7,15}"
            title="Enter 7–15 digits, optionally starting with +."
            aria-describedby="phone-help"
            required
          >

          <div id="phone-help" class="form-text">
            Use digits only, with an optional + country code.
          </div>
        </div>

        <button class="btn btn-primary" type="submit">
          Save phone number
        </button>
      </form>
    </div>
  </section>

  <section class="card" aria-labelledby="picture-heading">
    <div class="card-body">
      <h2 id="picture-heading" class="h4">
        Profile picture
      </h2>

      {{#if profile.hasPicture}}
        <img
          src="/profile/picture"
          alt="Your profile picture"
          class="rounded-circle mb-3"
          width="160"
          height="160"
          style="object-fit: cover;"
        >
      {{else}}
        <p>You haven’t added a profile picture yet.</p>
      {{/if}}

      <form
        action="/profile/picture"
        method="POST"
        enctype="multipart/form-data"
      >
        <input
          type="hidden"
          name="csrfToken"
          value="{{csrfToken}}"
        >

        <div class="mb-3">
          <label class="form-label" for="profilePicture">
            Choose a picture
          </label>

          <input
            class="form-control"
            type="file"
            id="profilePicture"
            name="profilePicture"
            accept="image/jpeg,image/png,image/webp"
            aria-describedby="picture-help"
            required
          >

          <div id="picture-help" class="form-text">
            JPEG, PNG, or WebP. Maximum 2 MB and 20 megapixels.
            Your picture will be cropped to a square.
          </div>
        </div>

        <button class="btn btn-primary" type="submit">
          Save picture
        </button>
      </form>
    </div>
  </section>
</main>