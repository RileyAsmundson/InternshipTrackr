
<div class="container browse-page">

  <!-- Page Header -->
  <div class="browse-header">
    <div>
      <h1>Browse Internships</h1>
      <p>Explore opportunities and find internships that match your interests.</p>
    </div>
  </div>

  <!-- Search and Filters -->
  <div class="browse-search-panel">
    <div class="search-panel-heading">
      <h2>Find an Internship</h2>
      <p>Search by keyword or narrow your results.</p>
    </div>

    <form action="/browse" method="GET">

      <div class="browse-field">
        <label for="search">Search Internships</label>
        <input
          type="text"
          class="form-control"
          id="search"
          name="search"
          placeholder="Job title, company, or location"
          value="{{search}}">
      </div>

      <div class="browse-filter-row">
        <div class="browse-field">
          <label for="company">Company</label>
          <input
            type="text"
            class="form-control"
            id="company"
            name="company"
            placeholder="e.g. Deloitte"
            value="{{company}}">
        </div>

        <div class="browse-field">
          <label for="state">State</label>
          <input
            type="text"
            class="form-control"
            id="state"
            name="state"
            placeholder="e.g. CO"
            maxlength="2"
            value="{{state}}">
        </div>
      </div>

      <div class="browse-search-actions">
        <button type="submit" class="browse-btn">
          Search Internships
        </button>

        <a href="/browse" class="browse-clear">
          Clear Filters
        </a>
      </div>

    </form>
  </div>

  <!-- API Error Message -->
  {{#if error}}

    <div class="alert alert-danger browse-alert">
      {{error}}
    </div>

  {{else}}

    <!-- Internship Results -->
    <div class="browse-results-header">
      <div>
        <h2>Available Internships</h2>
        <p>Browse open positions and explore opportunities.</p>
      </div>
    </div>

    <div class="internship-grid">
      {{#each internships}}

        <div class="internship-card">

          <div class="internship-card-top">
            <span class="internship-tag">
              Internship
            </span>
          </div>

          <h3 class="internship-title">
            {{this.role}}
          </h3>

          <p class="internship-company">
            {{this.company}}
          </p>

          <div class="internship-location">
            <span class="location-dot"></span>
            {{this.location}}
          </div>

          <!-- Expandable Description -->
          <details class="internship-details">
            <summary>View Details</summary>
            <div class="internship-description">
              {{this.description}}
            </div>
          </details>

          <!-- Application Link -->
          {{#if this.applicationUrl}}
            <div class="internship-card-footer">
              <a
                href="{{this.applicationUrl}}"
                target="_blank"
                rel="noopener noreferrer"
                class="browse-btn internship-apply">
                View Application
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          {{/if}}

        </div>

      {{else}}

        <div class="browse-empty-state">
          <h3>No internships found</h3>
          <p>
            Try searching for a different company,
            position, or location.
          </p>
          <a href="/browse" class="browse-btn">
            View All Internships
          </a>
        </div>

      {{/each}}
    </div>

  {{/if}}

</div>
