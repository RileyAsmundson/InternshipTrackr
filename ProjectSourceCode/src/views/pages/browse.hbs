<div class="container mt-4">
  <div class="mb-4">
    <h2 class="fw-bold">Browse Internships</h2>
    <p class="text-muted">
      Explore internship opportunities and find positions
      that match your interests.
    </p>
  </div>

  <!-- Internship Search -->
  <form action="/browse" method="GET">
    <label for="search" class="form-label">
      Search by company, position, or location
    </label>

    <div class="mb-2">
      <input type="text" class="form-control"
            id="search" name="search"
            placeholder="e.g. Deloitte, Analyst, Denver">
            value="{{search}}">

    </div>

    <!-- Additional Internship Filters -->
    <div class="row g-2 mb-2">
      <!-- Company Filter -->
      <div class="col-md-6">
        <label for="company" class="form-label">Company</label>
        <input type="text" class="form-control"
              id="company" name="company"
              placeholder="e.g. Deloitte"
              value="{{company}}">
      </div>

      <!-- State Filter -->
      <div class="col-md-6">
        <label for="state" class="form-label">State</label>
        <input type="text" class="form-control"
              id="state" name="state"
              placeholder="e.g. CO"
              maxlength="2"
              value="{{state}}">
      </div>
    </div>

    <button type="submit" class="btn btn-primary">
      Search
    </button>

  </form>

  <div class="mt-2">
    <a href="/browse" class="text-decoration-none">
      Clear Search
    </a>
  </div>

  <hr>

  <!-- API Error Message -->
  {{#if error}}
    <div class="alert alert-danger">
      {{error}}
    </div>
  {{else}}

  <!-- Internship Listings -->
  <h3>Available Internships</h3>

  {{#each internships}}
  <div class="card mb-3 shadow-sm">
    <div class="card-body">
      <h5 class="card-title fw-bold">{{this.role}}</h5>

      <h6 class="text-primary">
        {{this.company}}
      </h6>

      <p class="text-muted">
        Location: {{this.location}}
      </p>

        <details>
          <summary>View Details</summary>
          <p>{{this.description}}</p>
        </details>
        <!-- Application Link -->
        {{#if this.applicationUrl}}
          <a href="{{this.applicationUrl}}"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary mt-3">
            View Application
          </a>
        {{/if}}
    </div>
  </div>

  {{else}}
    <!-- No Search Results -->
    <div class="alert alert-info text-center">
      <h5>No internships found</h5>
      <p>
        Try searching for a different company,
        position, or location.
      </p>
      <a href="/browse" class="btn btn-outline-primary">
        View All Internships
      </a>
    </div>
  {{/each}}
{{/if}}
</div>
