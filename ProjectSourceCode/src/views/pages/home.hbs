
<div class="homepage">

  <!-- welcome header, display user's name -->
  <h1>Welcome Back{{#if username}}, {{username}}{{/if}}!</h1>

  <!-- boxes -->
  <div class="categories">

    <div class="category-box">
      <h3>Applications</h3>
      <p>{{totalApplications}}</p>
    </div>

    <div class="category-box">
      <h3>Interviews</h3>
      <p>{{totalInterviews}}</p>
    </div>

    <div class="category-box">
      <h3>Offers</h3>
      <p>{{totalOffers}}</p>
    </div>

    <div class="category-box">
      <h3>Upcoming Deadlines</h3>
      <p>{{upcomingDeadlines}}</p>
    </div>

  </div>

  <!-- bottom of the page, under the 4 boxes -->
  <div class="dashboard">

    <!-- upcoming tasks -->
    <div class="tasks">
      <h2>Upcoming Tasks</h2>

      <ul>
        {{#each tasks}}
          <li>
            <strong>{{this.title}}</strong>
            <p>{{this.dueDate}}</p>
          </li>
        {{else}}
          <li>No upcoming tasks.</li>
        {{/each}}
      </ul>
    </div>

    <!-- application status pie chart -->
    <div class="status">
      <h2>Application Status</h2>

      <div class="status-content">

        <!-- pie chart -->
        <div class="status-wheel"
             style="background: {{statusGradient}};">
        </div>

        <!-- status list -->
        <ul>
          {{#each applicationStatuses}}
            <li>
              <span class="status-color"
                    style="background-color: {{this.color}};">
              </span>
              {{this.name}}: {{this.count}}
            </li>
          {{/each}}
        </ul>

      </div>
    </div>

  </div>

</div>
