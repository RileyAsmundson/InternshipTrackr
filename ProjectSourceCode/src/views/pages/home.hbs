
<div class="homepage">

  <!-- welcome header, display user's name -->
  <h1>Welcome Back{{#if username}}, {{username}}{{/if}}!</h1>

  <!-- boxes -->
  <div class="categories">

    <div class="category-box">
      <h3>Applications</h3>
      <p>{{totalApplications}}</p>
    </div>

    <div class="category-box">
      <h3>Interviews</h3>
      <p>{{totalInterviews}}</p>
    </div>

    <div class="category-box">
      <h3>Offers</h3>
      <p>{{totalOffers}}</p>
    </div>

    <div class="category-box">
      <h3>Upcoming Deadlines</h3>
      <p>{{upcomingDeadlines}}</p>
    </div>

  </div>

  <!-- bottom of the page, under the 4 boxes -->
  <div class="dashboard">

    <!-- upcoming tasks -->
    <div class="tasks">
      <h2>Upcoming Tasks</h2>

      <!-- add deadline form -->
      <form action="/deadlines/add" method="POST" class="deadline-form">

        <input
          type="text"
          name="title"
          placeholder="Deadline title"
          maxlength="200"
          required
        >

        <input
          type="date"
          name="deadline_date"
          required
        >

        <button type="submit">Add Deadline</button>

      </form>

      <!-- upcoming deadlines -->
      <ul class="deadline-list">
        {{#each tasks}}
          <li class="deadline-item">

            <div class="deadline-info">
              <strong>{{this.title}}</strong>
              <p>{{this.dueDate}} — {{this.daysLeft}} days left</p>
            </div>

            <!-- deadline actions -->
            <div class="deadline-actions">

              <form action="/deadlines/{{this.id}}/complete" method="POST">
                <button type="submit">Complete</button>
              </form>

              <form action="/deadlines/{{this.id}}/delete" method="POST">
                <button type="submit">Delete</button>
              </form>

            </div>

          </li>
        {{else}}
          <li>No upcoming tasks.</li>
        {{/each}}
      </ul>

    </div>

    <!-- application status pie chart -->
    <div class="status">
      <h2>Application Status</h2>

      <div class="status-content">

        <!-- pie chart -->
        <div class="status-wheel"
             style="background: {{statusGradient}};">
        </div>

        <!-- status list -->
        <ul>
          {{#each applicationStatuses}}
            <li>
              <span class="status-color"
                    style="background-color: {{this.color}};">
              </span>
              {{this.name}}: {{this.count}}
            </li>
          {{/each}}
        </ul>

      </div>
    </div>

  </div>

</div>
